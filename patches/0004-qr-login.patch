+
+    /// Run the finalise script on an entry
+    async fn finalise(conn: &mut redis_kiss::Conn, id: &str) -> i32 {
+        redis::Script::new(SCRIPT_FINALISE)
+            .key(key(id))
+            .arg("{}")
+            .arg(60)
+            .invoke_async::<_, i32>(&mut **conn)
+            .await
+            .unwrap()
+    }
+
+    #[rocket::async_test]
+    async fn finalise_only_writes_to_claimed_entries() {
+        let mut conn = get_connection().await.unwrap();
+        let id = nanoid::nanoid!(32);
+        // Expired (missing) entry: nothing is written, nothing is recreated
+        assert_eq!(finalise(&mut conn, &id).await, 0);
+        let exists: bool = conn.exists(key(&id)).await.unwrap();
+        assert!(!exists);
+
+        // Not claimed
+        let _: () = conn.hset(key(&id), "status", "scanned").await.unwrap();
+        assert_eq!(finalise(&mut conn, &id).await, 0);
+
+        // Claimed
+        let _: () = conn.hset(key(&id), "status", "approving").await.unwrap();
+        assert_eq!(finalise(&mut conn, &id).await, 1);
+        let status: String = conn.hget(key(&id), "status").await.unwrap();
+        assert_eq!(status, "approved");
+        let _: () = conn.del(key(&id)).await.unwrap();
+    }
+}
