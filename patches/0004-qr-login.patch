+
+    /// Rate limits are not enforced in the test environment, so this checks
+    /// that start and poll land in their own buckets and that polls are
+    /// counted per QR id.
+    #[rocket::async_test]
+    async fn poll_and_start_use_their_own_buckets() {
+        let harness = TestHarness::new().await;
+        let bucket = |res: &rocket::local::asynchronous::LocalResponse<'_>| {
+            let get = |name| res.headers().get_one(name).map(str::to_string);
+            (get("X-RateLimit-Limit"), get("X-RateLimit-Bucket"))
+        };
+        let poll = |id: String| {
+            let client = &harness.client;
+            async move {
+                client
+                    .post(format!("/auth/session/qr/{id}/poll"))
+                    .header(ContentType::JSON)
+                    .body(json!({ "secret": "x" }).to_string())
+                    .dispatch()
+                    .await
+            }
+        };
+
+        let (id_a, id_b) = (nanoid::nanoid!(32), nanoid::nanoid!(32));
+        let first = bucket(&poll(id_a.clone()).await);
+        assert_eq!(first.0.as_deref(), Some("20"));
+        assert_eq!(first, bucket(&poll(id_a).await));
+        assert_ne!(first.1, bucket(&poll(id_b).await).1);
+
+        let res = harness
+            .client
+            .post("/auth/session/qr")
+            .header(ContentType::JSON)
+            .body("{}")
+            .dispatch()
+            .await;
+        let start = bucket(&res);
+        assert_eq!(start.0.as_deref(), Some("5"));
+        assert_ne!(start.1, first.1);
+    }
+
+    #[rocket::async_test]
+    async fn fail_approve_after_expiry_creates_no_session() {
+        let harness = TestHarness::new().await;
+        let (_, session, _) = harness.new_user().await;
+        let (id, secret) = start_login(&harness).await;
+        let before = harness.db.fetch_sessions(&session.user_id).await.unwrap().len();
+
+        // Simulate the entry expiring
+        let mut conn = get_connection().await.unwrap();
+        let _: () = conn.del(key(&id)).await.unwrap();
+
+        let password = json!({ "mfa_response": { "password": "password_insecure" } }).to_string();
+        assert_eq!(
+            approve(&harness, &id, &session.token, password).await,
+            Status::NotFound
+        );
+        assert_eq!(
+            poll_login(&harness, &id, &secret).await["status"],
+            "expired"
+        );
+        let after = harness.db.fetch_sessions(&session.user_id).await.unwrap().len();
