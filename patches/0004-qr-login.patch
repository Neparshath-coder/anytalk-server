+    #[rocket::async_test]
+    async fn fail_mfa_required() {
+        let harness = TestHarness::new().await;
+        let (mut account, session, _) = harness.new_user().await;
+        let totp = Totp::Enabled {
+            secret: "secret".to_string(),
