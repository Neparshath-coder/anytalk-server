+/// # Deny QR Login
+///
+/// Reject a pending QR login.
+#[openapi(tag = "Session")]
+#[post("/qr/<id>/deny")]
+pub async fn deny(id: &str, _session: Session) -> Result<rocket::response::status::NoContent> {
+    if !valid_id(id) {
+        return Err(create_error!(NotFound));
+    }
+
+    let mut conn = connection().await?;
+
+    if !transition(&mut conn, id, "denied", &["pending", "scanned"]).await? {
+        return Err(create_error!(NotFound));
+    }
+
+    let _: () = conn
+        .expire(key(id), QR_RESULT_TTL_SECS as usize)
+        .await
+        .to_internal_error()?;
+
+    Ok(rocket::response::status::NoContent)
+}
