+//! Log in a new device by scanning a QR code with an already logged-in one
+//!
+//! POST /session/qr, POST /session/qr/<id>/poll, POST /session/qr/<id>/info,
+//! POST /session/qr/<id>/approve, POST /session/qr/<id>/deny
+//!
+//! Pending logins live only in Valkey (`anytalk:qr:<id>`, a hash) and expire
+//! on their own after `QR_TTL_SECS`. The `id` is shown in the QR code. The
+//! `secret` never leaves the new device (only its SHA-256 is stored), so
+//! somebody who sees the QR code cannot collect the session.
+use std::net::IpAddr;
+
+use iso8601_timestamp::{Duration, Timestamp};
+use redis_kiss::{AsyncCommands, Conn, get_connection, redis};
+use revolt_database::{Account, Database, Session, util::ip::rocket::to_real_ip};
+use revolt_models::v0;
+use revolt_result::{Error, Result, ToRevoltError, create_error};
+use revolt_rocket_okapi::{
+    OpenApiError,
+    r#gen::OpenApiGenerator,
+    request::{OpenApiFromRequest, RequestHeaderInput},
+    response::OpenApiResponderInner,
+    revolt_okapi::openapi3::Responses,
+};
+use rocket::{
+    State,
+    http::Header,
+    request::{FromRequest, Outcome, Request},
+    response::{self, Responder},
+    serde::json::Json,
+};
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+/// How long a pending QR login can be approved, in seconds
+const QR_TTL_SECS: i64 = 120;
+
+/// How long the new device has to collect the result once it is decided
+const QR_RESULT_TTL_SECS: i64 = 60;
+
+/// Wrong MFA codes or passwords allowed before the pending login is denied
+const QR_MAX_ATTEMPTS: i64 = 3;
+
+/// How many pending logins may exist at once, so `start` cannot fill Valkey
+const QR_MAX_PENDING: i64 = 1000;
+
+/// Longest friendly name kept, in characters
+const QR_MAX_NAME_CHARS: usize = 64;
+
+/// Longest User-Agent kept, in characters
+const QR_MAX_AGENT_CHARS: usize = 200;
+
+/// Length of a pending login id (a nanoid)
+const QR_ID_LEN: usize = 32;
+
+/// Valkey sorted set of pending ids scored by expiry time, for the global cap
+const QR_INDEX_KEY: &str = "anytalk:qr-index";
+
+/// Create the entry unless the cap is reached
+/// KEYS: entry, index. ARGV: now, cap, ttl, id, then field/value pairs.
+const SCRIPT_START: &str = r#"
+redis.call('ZREMRANGEBYSCORE', KEYS[2], '-inf', ARGV[1])
+if redis.call('ZCARD', KEYS[2]) >= tonumber(ARGV[2]) then return 0 end
+redis.call('ZADD', KEYS[2], tonumber(ARGV[1]) + tonumber(ARGV[3]), ARGV[4])
+redis.call('EXPIRE', KEYS[2], 600)
+redis.call('HSET', KEYS[1], unpack(ARGV, 5))
+redis.call('EXPIRE', KEYS[1], ARGV[3])
+return 1
+"#;
+
+/// Set the status to ARGV[1] if it currently is one of the other ARGV values
+const SCRIPT_TRANSITION: &str = r#"
+local current = redis.call('HGET', KEYS[1], 'status')
+if not current then return 0 end
+for i = 2, #ARGV do
+  if current == ARGV[i] then
+    redis.call('HSET', KEYS[1], 'status', ARGV[1])
+    return 1
+  end
+end
+return 0
+"#;
+
+/// Count a failed approve attempt of a claimed (`approving`) entry and either
+/// give it back (`scanned`) or deny it once ARGV[1] attempts are used up.
+/// Never recreates an expired entry. Returns -1 if it was not claimed.
+const SCRIPT_FAILED_ATTEMPT: &str = r#"
+if redis.call('HGET', KEYS[1], 'status') ~= 'approving' then return -1 end
+local attempts = redis.call('HINCRBY', KEYS[1], 'attempts', 1)
+if attempts >= tonumber(ARGV[1]) then
+  redis.call('HSET', KEYS[1], 'status', 'denied')
+  redis.call('EXPIRE', KEYS[1], ARGV[2])
+else
+  redis.call('HSET', KEYS[1], 'status', 'scanned')
+end
+return attempts
+"#;
+
+/// Store the session, but only if the entry still is claimed (`approving`),
+/// i.e. it has not expired in the meantime. KEYS: entry. ARGV: session, ttl.
+const SCRIPT_FINALISE: &str = r#"
+if redis.call('HGET', KEYS[1], 'status') ~= 'approving' then return 0 end
+redis.call('HSET', KEYS[1], 'session', ARGV[1], 'status', 'approved')
+redis.call('EXPIRE', KEYS[1], ARGV[2])
+return 1
+"#;
+
+/// Return the stored session and delete the entry, but only if it is approved,
+/// so that two parallel polls cannot both receive the session
+const SCRIPT_TAKE_APPROVED: &str = r#"
+if redis.call('HGET', KEYS[1], 'status') ~= 'approved' then return false end
+local session = redis.call('HGET', KEYS[1], 'session')
+redis.call('DEL', KEYS[1])
+return session
+"#;
+
+/// A JSON response that browsers and proxies must not cache
+pub struct NoStore<T>(Json<T>);
+
+impl<'r, 'o: 'r, T: Serialize> Responder<'r, 'o> for NoStore<T> {
+    fn respond_to(self, request: &'r Request<'_>) -> response::Result<'o> {
+        let mut response = self.0.respond_to(request)?;
+        response.set_header(Header::new("Cache-Control", "no-store"));
+        Ok(response)
+    }
+}
+
+impl<T: Serialize + JsonSchema + Send> OpenApiResponderInner for NoStore<T> {
+    fn responses(generator: &mut OpenApiGenerator) -> std::result::Result<Responses, OpenApiError> {
+        <Json<T> as OpenApiResponderInner>::responses(generator)
+    }
+}
+
+/// Where a request comes from, as far as the approver may see it
+pub struct ClientInfo {
+    /// Coarse IP (see `coarse_ip`), empty if unknown
+    ip: String,
+    /// Cleaned and shortened User-Agent, empty if unknown
+    user_agent: String,
+}
+
+#[rocket::async_trait]
+impl<'r> FromRequest<'r> for ClientInfo {
+    type Error = Error;
+
+    async fn from_request(request: &'r Request<'_>) -> Outcome<Self, Self::Error> {
+        // `to_real_ip` honours the configured proxy header (X-Forwarded-For)
+        Outcome::Success(ClientInfo {
+            ip: coarse_ip(&to_real_ip(request).await),
+            user_agent: clean_text(
+                request.headers().get_one("User-Agent").unwrap_or_default(),
+                QR_MAX_AGENT_CHARS,
+            ),
+        })
+    }
+}
+
+impl OpenApiFromRequest<'_> for ClientInfo {
+    fn from_request_input(
+        _gen: &mut OpenApiGenerator,
+        _name: String,
+        _required: bool,
+    ) -> revolt_rocket_okapi::Result<RequestHeaderInput> {
+        Ok(RequestHeaderInput::None)
+    }
+}
+
+/// # Start QR Login Data
+#[derive(Deserialize, JsonSchema)]
+pub struct DataQrStart {
+    /// Friendly name used for the session that is created on approval
+    #[serde(default)]
+    friendly_name: Option<String>,
+}
+
+/// # Pending QR Login
+#[derive(Serialize, JsonSchema)]
+pub struct ResponseQrStart {
+    /// Id to put into the QR code
+    id: String,
+    /// Secret for polling, only for the new device
+    secret: String,
+    /// When the pending login expires
+    expires_at: Timestamp,
+}
+
+/// # Poll QR Login Data
+#[derive(Deserialize, JsonSchema)]
+pub struct DataQrPoll {
+    /// Secret returned when the QR login was started
+    secret: String,
+}
+
+/// # QR Login State
+#[derive(Serialize, JsonSchema)]
+#[serde(tag = "status", rename_all = "lowercase")]
+pub enum ResponseQrPoll {
+    /// Waiting for a logged-in device to scan the code
+    Pending,
+    /// A logged-in device opened the request and is deciding
+    Scanned,
+    /// The request was denied
+    Denied,
+    /// The request expired, does not exist or the secret was wrong
+    Expired,
+    /// The request was approved. This is returned exactly once.
+    Approved { session: v0::Session },
+}
+
+/// What the approver has to enter to approve
+#[derive(Serialize, JsonSchema)]
+#[serde(rename_all = "snake_case")]
+pub enum QrApproveMethod {
+    /// The account has no MFA, ask for the account password
+    Password,
+    /// The account has MFA, ask for a TOTP code or a recovery code
+    TotpOrRecovery,
+}
+
+/// # Pending QR Login Info
+#[derive(Serialize, JsonSchema)]
+pub struct ResponseQrInfo {
+    /// Friendly name of the device that wants to log in
+    friendly_name: String,
+    /// When the new device created the request
+    created_at: Timestamp,
+    /// When the request expires
+    expires_at: Timestamp,
+    /// What to ask the user for when approving
+    method: QrApproveMethod,
+    /// Coarse IP address (last part hidden) the request came from
+    #[serde(skip_serializing_if = "Option::is_none")]
+    ip: Option<String>,
+    /// User-Agent the request came from
+    #[serde(skip_serializing_if = "Option::is_none")]
+    user_agent: Option<String>,
+}
+
+/// # Approve QR Login Data
+#[derive(Deserialize, JsonSchema)]
+pub struct DataQrApprove {
+    /// Required: `{"password"}` for accounts without MFA, otherwise
+    /// `{"totp_code"}` or `{"recovery_code"}`
+    #[serde(default)]
+    mfa_response: Option<v0::MFAResponse>,
+}
+
+/// Valkey key of a pending login
+fn key(id: &str) -> String {
+    format!("anytalk:qr:{id}")
+}
+
+/// Check that an id looks like one we generated, before it goes into a key
+fn valid_id(id: &str) -> bool {
+    id.len() == QR_ID_LEN
+        && id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+}
+
+/// Remove control, bidi and zero-width characters, trim and shorten text
+fn clean_text(text: &str, max_chars: usize) -> String {
+    let cleaned: String = text
+        .chars()
+        .filter(|c| {
+            !c.is_control()
+                && !matches!(
+                    c,
+                    '\u{061C}'
+                        | '\u{200B}'..='\u{200F}'
+                        | '\u{202A}'..='\u{202E}'
+                        | '\u{2060}'..='\u{2064}'
+                        | '\u{2066}'..='\u{2069}'
+                        | '\u{FEFF}'
+                )
+        })
+        .take(max_chars)
+        .collect();
+    cleaned.trim().to_string()
+}
+
+/// Friendly name for the new session, "Unknown" if nothing usable is left
+fn clean_name(name: Option<String>) -> String {
+    let name = clean_text(&name.unwrap_or_default(), QR_MAX_NAME_CHARS);
+    if name.is_empty() {
+        "Unknown".to_string()
+    } else {
+        name
+    }
+}
+
+/// Hide the last part of an IP address (IPv4 /24, IPv6 /48)
+fn coarse_ip(ip: &str) -> String {
+    match ip.parse::<IpAddr>() {
+        Ok(IpAddr::V4(ip)) => {
+            let [a, b, c, _] = ip.octets();
+            format!("{a}.{b}.{c}.0")
+        }
+        Ok(IpAddr::V6(ip)) => {
+            let [a, b, c, ..] = ip.segments();
+            format!("{a:x}:{b:x}:{c:x}::")
+        }
+        Err(_) => String::new(),
+    }
+}
+
+/// Hex SHA-256 of a polling secret
+fn hash_secret(secret: &str) -> String {
+    Sha256::digest(secret.as_bytes())
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+/// Compare two strings in constant time (for equal length)
+fn constant_time_eq(a: &str, b: &str) -> bool {
+    a.len() == b.len()
+        && a.bytes()
+            .zip(b.bytes())
+            .fold(0u8, |diff, (x, y)| diff | (x ^ y))
+            == 0
+}
+
+/// Open a Valkey connection
+async fn connection() -> Result<Conn> {
+    get_connection()
+        .await
+        .map_err(|_| create_error!(InternalError))
+}
+
+/// Atomically move the entry to `to` if it is currently in one of `from`
+async fn transition(conn: &mut Conn, id: &str, to: &str, from: &[&str]) -> Result<bool> {
+    let moved: i32 = redis::Script::new(SCRIPT_TRANSITION)
+        .key(key(id))
+        .arg(to)
+        .arg(from)
+        .invoke_async(&mut **conn)
+        .await
+        .to_internal_error()?;
+
+    Ok(moved == 1)
+}
+
+/// Fields of a pending login that has not been decided yet
+struct Pending {
+    friendly_name: String,
+    created_at: Timestamp,
+    ip: Option<String>,
+    user_agent: Option<String>,
+}
+
+/// Fetch a pending login that can still be approved or denied
+async fn fetch_pending(conn: &mut Conn, id: &str) -> Result<Pending> {
+    if !valid_id(id) {
+        return Err(create_error!(NotFound));
+    }
+
+    let (status, friendly_name, created_at, ip, user_agent): (
+        Option<String>,
+        Option<String>,
+        Option<String>,
+        Option<String>,
+        Option<String>,
+    ) = redis::cmd("HMGET")
+        .arg(key(id))
+        .arg(&["status", "name", "created", "ip", "ua"])
+        .query_async(&mut **conn)
+        .await
+        .to_internal_error()?;
+
+    match (status.as_deref(), friendly_name, created_at) {
+        (Some("pending" | "scanned"), Some(friendly_name), Some(created_at)) => Ok(Pending {
+            friendly_name,
+            created_at: Timestamp::parse(&created_at).to_internal_error()?,
+            ip: ip.filter(|ip| !ip.is_empty()),
+            user_agent: user_agent.filter(|agent| !agent.is_empty()),
+        }),
+        _ => Err(create_error!(NotFound)),
+    }
+}
+
+/// # Start QR Login
+///
+/// Start a login for a new device. The returned `id` is shown as a QR code,
+/// the `secret` is used by the new device to poll for the result.
+#[openapi(tag = "Session")]
+#[post("/qr", data = "<data>")]
+pub async fn start(
+    data: Json<DataQrStart>,
+    client: ClientInfo,
+) -> Result<NoStore<ResponseQrStart>> {
+    let id = nanoid::nanoid!(QR_ID_LEN);
+    let secret = nanoid::nanoid!(64);
+    let now = Timestamp::now_utc();
+    let name = clean_name(data.into_inner().friendly_name);
+
+    let mut conn = connection().await?;
+    let created: i32 = redis::Script::new(SCRIPT_START)
+        .key(key(&id))
+        .key(QR_INDEX_KEY)
+        .arg(
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .to_internal_error()?
+                .as_secs(),
+        )
+        .arg(QR_MAX_PENDING)
+        .arg(QR_TTL_SECS)
+        .arg(&id)
+        .arg("secret")
+        .arg(hash_secret(&secret))
+        .arg("name")
+        .arg(name)
+        .arg("created")
+        .arg(now.format().to_string())
+        .arg("status")
+        .arg("pending")
+        .arg("attempts")
+        .arg(0)
+        .arg("ip")
+        .arg(client.ip)
+        .arg("ua")
+        .arg(client.user_agent)
+        .invoke_async(&mut *conn)
+        .await
+        .to_internal_error()?;
+
+    // Too many pending logins right now
+    if created != 1 {
+        return Err(create_error!(OperationFailed));
+    }
+
+    Ok(NoStore(Json(ResponseQrStart {
+        id,
+        secret,
+        expires_at: now
+            .checked_add(Duration::seconds(QR_TTL_SECS))
+            .to_internal_error()?,
+    })))
+}
+
+/// # Poll QR Login
+///
+/// Called by the new device. An approved login returns the new session once,
+/// then the pending login is deleted. A wrong secret looks like an unknown id.
+#[openapi(tag = "Session")]
+#[post("/qr/<id>/poll", data = "<data>")]
+pub async fn poll(id: &str, data: Json<DataQrPoll>) -> Result<NoStore<ResponseQrPoll>> {
+    if !valid_id(id) {
+        return Ok(NoStore(Json(ResponseQrPoll::Expired)));
+    }
+
+    let mut conn = connection().await?;
+
+    let stored: Option<String> = conn.hget(key(id), "secret").await.to_internal_error()?;
+    let Some(stored) = stored else {
+        return Ok(NoStore(Json(ResponseQrPoll::Expired)));
+    };
+
+    if !constant_time_eq(&stored, &hash_secret(&data.secret)) {
+        return Ok(NoStore(Json(ResponseQrPoll::Expired)));
+    }
+
+    let status: Option<String> = conn.hget(key(id), "status").await.to_internal_error()?;
+    Ok(NoStore(Json(match status.as_deref() {
+        Some("pending") => ResponseQrPoll::Pending,
+        Some("scanned" | "approving") => ResponseQrPoll::Scanned,
+        Some("denied") => {
+            let _: () = conn.del(key(id)).await.to_internal_error()?;
+            ResponseQrPoll::Denied
+        }
+        Some("approved") => {
+            let session: Option<String> = redis::Script::new(SCRIPT_TAKE_APPROVED)
+                .key(key(id))
+                .invoke_async(&mut *conn)
+                .await
+                .to_internal_error()?;
+
+            match session {
+                Some(session) => ResponseQrPoll::Approved {
+                    session: serde_json::from_str(&session).to_internal_error()?,
+                },
+                // Another poll took it first
+                None => ResponseQrPoll::Expired,
+            }
+        }
+        _ => ResponseQrPoll::Expired,
+    })))
+}
+
+/// # Fetch QR Login Info
+///
+/// Called by a logged-in device after scanning the code. Marks the pending
+/// login as scanned (hence POST).
+#[openapi(tag = "Session")]
+#[post("/qr/<id>/info")]
+pub async fn info(id: &str, _session: Session, account: Account) -> Result<Json<ResponseQrInfo>> {
+    if account.disabled {
+        return Err(create_error!(InvalidOperation));
+    }
+
+    let mut conn = connection().await?;
+    let pending = fetch_pending(&mut conn, id).await?;
+    transition(&mut conn, id, "scanned", &["pending"]).await?;
+
+    Ok(Json(ResponseQrInfo {
+        friendly_name: pending.friendly_name,
+        expires_at: pending
+            .created_at
+            .checked_add(Duration::seconds(QR_TTL_SECS))
+            .to_internal_error()?,
+        created_at: pending.created_at,
+        method: if account.mfa.is_active() {
+            QrApproveMethod::TotpOrRecovery
+        } else {
+            QrApproveMethod::Password
+        },
+        ip: pending.ip,
+        user_agent: pending.user_agent,
+    }))
+}
+
+/// # Approve QR Login
+///
+/// Create a session for the new device on this account. Needs the password,
+/// or an MFA response if the account has MFA active.
+#[openapi(tag = "Session")]
+#[post("/qr/<id>/approve", data = "<data>")]
+pub async fn approve(
+    db: &State<Database>,
+    id: &str,
+    _session: Session,
+    mut account: Account,
+    data: Json<DataQrApprove>,
+) -> Result<rocket::response::status::NoContent> {
+    // Same rule as login: disabled accounts cannot create sessions
+    if account.disabled {
+        return Err(create_error!(InvalidOperation));
+    }
+
+    let mut conn = connection().await?;
+    let pending = fetch_pending(&mut conn, id).await?;
+
+    // Check for account lockout, like login
+    if let Some(lockout) = &account.lockout {
+        if lockout
+            .expiry
+            .is_some_and(|expiry| expiry > Timestamp::now_utc())
+        {
+            db.bump_lockout_count(&account.id).await?;
+            return Err(create_error!(LockedOut));
+        }
+    }
+
+    let Some(response) = data.into_inner().mfa_response else {
+        return Err(if account.mfa.is_active() {
+            create_error!(InvalidToken)
+        } else {
+            create_error!(InvalidCredentials)
+        });
+    };
+
+    // Claim the request first, so that only one approve can win and a losing
+    // one does not spend a recovery code
+    if !transition(&mut conn, id, "approving", &["pending", "scanned"]).await? {
+        return Err(create_error!(InvalidOperation));
+    }
+
+    // Password for accounts without MFA, TOTP or recovery code otherwise
+    if let Err(err) = account.consume_mfa_response(db, response, None).await {
+        db.bump_lockout_count(&account.id).await?;
+
+        // Give the request back, or deny it when the attempts are used up
+        let _: i64 = redis::Script::new(SCRIPT_FAILED_ATTEMPT)
+            .key(key(id))
+            .arg(QR_MAX_ATTEMPTS)
+            .arg(QR_RESULT_TTL_SECS)
+            .invoke_async(&mut *conn)
+            .await
+            .to_internal_error()?;
+
+        return Err(err);
+    }
+
+    // Verified, clear lockout information if present
+    if account.lockout.is_some() {
+        account.lockout = None;
+        account.save(db).await?;
+    }
+
+    let session = match account.create_session(db, pending.friendly_name).await {
+        Ok(session) => session,
+        Err(err) => {
+            // Let the approver try again
+            transition(&mut conn, id, "scanned", &["approving"]).await?;
+            return Err(err);
+        }
+    };
+
+    // Hand the session over, but only if the request is still claimed
+    let stored = redis::Script::new(SCRIPT_FINALISE)
+        .key(key(id))
+        .arg(serde_json::to_string(&v0::Session::from(session.clone())).to_internal_error()?)
+        .arg(QR_RESULT_TTL_SECS)
+        .invoke_async::<_, i32>(&mut *conn)
+        .await;
+
+    if !matches!(stored, Ok(1)) {
+        // Expired meanwhile or Valkey failed: nobody can collect this session
+        log::warn!("QR login {id} could not be finalised ({stored:?}), removing session");
+        session.delete(db).await?;
+        return Err(match stored {
+            Err(_) => create_error!(InternalError),
+            Ok(_) => create_error!(NotFound),
+        });
+    }
+
+    Ok(rocket::response::status::NoContent)
+}
