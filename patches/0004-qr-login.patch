+
+        assert_eq!(
+            approve(&harness, &id, tok, "{}".into()).await,
+            Status::Unauthorized
+        );
+        // The password is not accepted for accounts with MFA
+        let password = json!({ "mfa_response": { "password": "password_insecure" } }).to_string();
+        assert_eq!(
+            approve(&harness, &id, tok, password).await,
+            Status::BadRequest
+        );
+        let wrong = json!({ "mfa_response": { "totp_code": "000000" } }).to_string();
+        assert_eq!(
+            approve(&harness, &id, tok, wrong).await,
+            Status::Unauthorized
+        );
+        assert_eq!(
+            poll_login(&harness, &id, &secret).await["status"],
+            "scanned"
+        );
+
+        let code = totp.generate_code().unwrap();
+        let good = json!({ "mfa_response": { "totp_code": code } }).to_string();
+        assert_eq!(approve(&harness, &id, tok, good).await, Status::NoContent);
+        assert_eq!(
+            poll_login(&harness, &id, &secret).await["status"],
+            "approved"
