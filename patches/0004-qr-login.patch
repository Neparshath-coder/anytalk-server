+        assert_eq!(clean_name(None), "Unknown");
+        assert_eq!(clean_name(Some("  \u{202E}\n\u{200B} ".into())), "Unknown");
+        assert_eq!(clean_name(Some(" My\u{202E} Phone\n".into())), "My Phone");
+        assert_eq!(clean_name(Some("a".repeat(500))).chars().count(), 64);
+    }
+
+    #[test]
+    fn validates_ids_and_hides_ips() {
+        assert!(valid_id(&"aZ09_-".repeat(6)[..32]));
+        assert!(!valid_id("short"));
+        assert!(!valid_id(&"a:".repeat(16)));
+        assert_eq!(coarse_ip("203.0.113.77"), "203.0.113.0");
+        assert_eq!(coarse_ip("2001:db8:1234:5678::1"), "2001:db8:1234::");
+        assert_eq!(coarse_ip("garbage"), "");
+    }
+
+    /// Start a QR login, returns (id, secret)
+    async fn start_login(harness: &TestHarness) -> (String, String) {
+        let res = harness
+            .client
+            .post("/auth/session/qr")
+            .header(ContentType::JSON)
+            .header(Header::new("User-Agent", "TestAgent/1.0"))
+            .body(json!({ "friendly_name": "Phone" }).to_string())
+            .dispatch()
+            .await;
+        assert_eq!(res.status(), Status::Ok);
+        assert_eq!(res.headers().get_one("Cache-Control"), Some("no-store"));
+        assert_eq!(res.headers().get_one("X-RateLimit-Limit"), Some("5"));
+        let body: serde_json::Value = res.into_json().await.unwrap();
+        (
+            body["id"].as_str().unwrap().to_string(),
+            body["secret"].as_str().unwrap().to_string(),
+        )
+    }
+
+    /// Poll a QR login with the given secret
+    async fn poll_login(harness: &TestHarness, id: &str, secret: &str) -> serde_json::Value {
+        let res = harness
+            .client
+            .post(format!("/auth/session/qr/{id}/poll"))
+            .header(ContentType::JSON)
+            .body(json!({ "secret": secret }).to_string())
+            .dispatch()
+            .await;
+        assert_eq!(res.status(), Status::Ok);
+        assert_eq!(res.headers().get_one("Cache-Control"), Some("no-store"));
+        assert_eq!(res.headers().get_one("X-RateLimit-Limit"), Some("20"));
+        res.into_json().await.unwrap()
+    }
+
+    /// Approve a QR login as the given session with a JSON body
+    async fn approve(harness: &TestHarness, id: &str, token: &str, body: String) -> Status {
+        harness
+            .client
+            .post(format!("/auth/session/qr/{id}/approve"))
+            .header(ContentType::JSON)
+            .header(Header::new("X-Session-Token", token.to_string()))
+            .body(body)
+            .dispatch()
+            .await
+            .status()
+    }
+
+    #[rocket::async_test]
+    async fn success_approve_once() {
+        let harness = TestHarness::new().await;
+        let (_, session, _) = harness.new_user().await;
+        let (id, secret) = start_login(&harness).await;
+        let password = json!({ "mfa_response": { "password": "password_insecure" } }).to_string();
+
+        assert_eq!(
+            poll_login(&harness, &id, &secret).await["status"],
+            "pending"
+        );
+        // A wrong secret looks like an unknown id
+        assert_eq!(
+            poll_login(&harness, &id, "wrong").await["status"],
+            "expired"
+        );
+
+        let res = harness
+            .client
+            .post(format!("/auth/session/qr/{id}/info"))
+            .header(Header::new("X-Session-Token", session.token.clone()))
+            .dispatch()
+            .await;
+        assert_eq!(res.status(), Status::Ok);
+        let info: serde_json::Value = res.into_json().await.unwrap();
+        assert_eq!(info["friendly_name"], "Phone");
+        assert_eq!(info["method"], "password");
+        assert_eq!(info["user_agent"], "TestAgent/1.0");
+        assert!(info.get("secret").is_none());
+        assert_eq!(
+            poll_login(&harness, &id, &secret).await["status"],
+            "scanned"
+        );
+
+        // No password or a wrong one does not approve and keeps the request open
+        let tok = &session.token;
+        assert_eq!(
+            approve(&harness, &id, tok, "{}".into()).await,
+            Status::Unauthorized
+        );
+        let wrong = json!({ "mfa_response": { "password": "nope" } }).to_string();
+        assert_eq!(
+            approve(&harness, &id, tok, wrong).await,
+            Status::Unauthorized
+        );
+        assert_eq!(
+            poll_login(&harness, &id, &secret).await["status"],
+            "scanned"
+        );
+
+        assert_eq!(
+            approve(&harness, &id, tok, password.clone()).await,
+            Status::NoContent
+        );
+        // A second approve must not create another session
+        assert_eq!(
+            approve(&harness, &id, tok, password).await,
+            Status::NotFound
+        );
+
+        let body = poll_login(&harness, &id, &secret).await;
+        assert_eq!(body["status"], "approved");
+        assert_eq!(body["session"]["user_id"], session.user_id);
+        assert_eq!(body["session"]["name"], "Phone");
+
+        // The session is handed out exactly once
+        assert_eq!(
+            poll_login(&harness, &id, &secret).await["status"],
+            "expired"
+        );
+    }
+
+    #[rocket::async_test]
